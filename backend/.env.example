# ==========================================
# Totally Spies Backend Configuration
# ==========================================

# Application Name & API Prefix
PROJECT_NAME="Totally Spies OSINT Suite"
API_V1_STR="/api"

# Database Connection (Async SQLite by default)
DATABASE_URL="sqlite+aiosqlite:///totally_spies.db"

# Scanner Engine Defaults
DEFAULT_CONCURRENCY=15
DEFAULT_TIMEOUT=6.0

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["*"]
